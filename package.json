{
  "name": "viper",
  "productName": "Viper",
  "version": "0.1.6",
  "description": "Viper — a voice-first, floating holographic AI desktop assistant.",
  "author": "David Monday Nwankwo",
  "private": true,
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VIPER_DEV=1 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^44.4.1",
    "electron-builder": "^26.16.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.davidnwankwo.viper",
    "productName": "Viper",
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": {"target": ["nsis"]},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true}
  }
}
